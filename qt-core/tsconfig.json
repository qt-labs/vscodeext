{
  "extends": "../common/tsconfig.base.json",
  "compilerOptions": {
    /* TODO: fast-xml-builder ships a syntactically invalid lib/fxb.d.cts (as of
       1.3.0), which node16 resolution picks for CommonJS consumers and tsc
       fails to parse. Remove once fixed upstream. */
    "skipLibCheck": true,
    "outDir": "out",
    "rootDirs": ["src", "test"],
    "paths": {
      "@/*": ["./src/*"],
      "@cmd/*": ["./src/commands/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["webview-ui/**/*"]
}
