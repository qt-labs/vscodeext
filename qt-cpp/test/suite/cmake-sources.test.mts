import * as fs from 'fs';
import * as os from 'os';
import * as path from 'path';
import { expect } from 'chai';

import { hasCMakeSources } from '@/util/cmake-sources.js';

describe('hasCMakeSources', () => {
  let folder: string;

  function addCMakeLists(dir: string) {
    fs.mkdirSync(path.join(folder, dir), { recursive: true });
    fs.writeFileSync(path.join(folder, dir, 'CMakeLists.txt'), '');
  }

  beforeEach(() => {
    folder = fs.mkdtempSync(path.join(os.tmpdir(), 'qt-cpp-cmake-sources-'));
  });

  afterEach(() => {
    fs.rmSync(folder, { recursive: true, force: true });
  });

  it('detects CMakeLists.txt in the workspace folder', () => {
    addCMakeLists('.');
    expect(hasCMakeSources(folder, undefined)).to.equal(true);
  });

  it('ignores CMake projects generated by other builds', () => {
    // The CMake project that a Qt Bridge for C# build generates.
    addCMakeLists(
      path.join('obj', 'arm64', 'Debug', 'net8.0', 'qt', 'native', 'source')
    );
    addCMakeLists(path.join('build', '_deps', 'fmt-src'));
    expect(hasCMakeSources(folder, undefined)).to.equal(false);
    expect(hasCMakeSources(folder, '${workspaceFolder}')).to.equal(false);
  });

  it('detects a source directory like CMake Tools does', () => {
    addCMakeLists(path.join('src', 'app'));
    expect(hasCMakeSources(folder, undefined)).to.equal(true);
    expect(hasCMakeSources(folder, undefined, false)).to.equal(false);
  });

  it('does not detect source directories deeper than CMake Tools', () => {
    addCMakeLists(path.join('a', 'b', 'c', 'd'));
    expect(hasCMakeSources(folder, undefined)).to.equal(false);
  });

  it('resolves configured source directories', () => {
    addCMakeLists('app');
    expect(hasCMakeSources(folder, '${workspaceFolder}/app')).to.equal(true);
    expect(hasCMakeSources(folder, 'app')).to.equal(true);
    expect(hasCMakeSources(folder, ['lib', 'app'])).to.equal(true);
    expect(hasCMakeSources(folder, ['lib'])).to.equal(false);
  });

  it('keeps folders with unresolvable source directories', () => {
    expect(hasCMakeSources(folder, '${env:SOURCE_DIR}')).to.equal(true);
  });
});
