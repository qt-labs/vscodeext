{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "qml",
  "scopeName": "source.qml",
  "patterns": [
    {
      "include": "#pragma"
    },
    {
      "include": "#import"
    },
    {
      "include": "#object"
    },
    {
      "include": "#comment"
    }
  ],
  "repository": {
    "pragma": {
      "name": "meta.pragma.qml",
      "begin": "\\b(pragma)\\s+([A-Z]\\w*)(?:\\s*:\\s*([_a-zA-Z]\\w*))?\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.pragma.qml"
        },
        "2": {
          "name": "entity.other.attribute-name.pragma.qml"
        },
        "3": {
          "name": "constant.language.pragma.qml"
        }
      },
      "end": "$",
      "patterns": [
        {
          "match": ",\\s*([_a-zA-Z]\\w*)\\b",
          "captures": {
            "1": {
              "name": "constant.language.pragma.qml"
            }
          }
        },
        {
          "include": "#string"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#semicolon"
        }
      ]
    },
    "import": {
      "name": "meta.import.qml",
      "begin": "\\b(import)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.import.qml"
        }
      },
      "end": "$",
      "patterns": [
        {
          "match": "\\b([A-Z][\\w\\.]*)(?:\\s+(\\d+(?:\\.\\d+)?))?",
          "captures": {
            "1": {
              "name": "entity.name.namespace.qml"
            },
            "2": {
              "name": "constant.numeric.version.qml"
            }
          }
        },
        {
          "match": "\\b(as)\\s+([A-Z]\\w*)",
          "captures": {
            "1": {
              "name": "keyword.control.as.qml"
            },
            "2": {
              "name": "entity.name.namespace.qml"
            }
          }
        },
        {
          "include": "#string"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#semicolon"
        }
      ]
    },
    "object": {
      "patterns": [
        {
          "include": "#object-declaration"
        },
        {
          "include": "#object-type-only"
        },
        {
          "include": "#object-block"
        }
      ]
    },
    "object-type-only": {
      "match": "\\b([A-Z][\\w\\.]*)(?=\\s*(?:\\/\\/.*|\\/\\*.*)?$)",
      "captures": {
        "1": {
          "name": "entity.name.type.object.qml"
        }
      }
    },
    "object-block": {
      "name": "meta.object.qml",
      "begin": "^\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.block.qml"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.qml"
        }
      },
      "patterns": [
        {
          "include": "#object-contents"
        }
      ]
    },
    "object-declaration": {
      "name": "meta.object.qml",
      "begin": "\\b([A-Z][\\w\\.]*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.object.qml"
        },
        "2": {
          "name": "punctuation.definition.block.qml"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.qml"
        }
      },
      "patterns": [
        {
          "include": "#object-contents"
        }
      ]
    },
    "object-contents": {
      "patterns": [
        {
          "include": "$self"
        },
        {
          "include": "#object"
        },
        {
          "include": "#signal"
        },
        {
          "include": "#property-declaration"
        },
        {
          "include": "#prop-force-required"
        },
        {
          "include": "#method"
        },
        {
          "include": "#on-prop"
        },
        {
          "include": "#on-prop-type-only"
        },
        {
          "include": "#comp-inline"
        },
        {
          "include": "#id-assignment"
        },
        {
          "include": "#attr-general"
        },
        {
          "include": "#attr-group-notation"
        },
        {
          "include": "#enum"
        },
        {
          "include": "#enum-type-only"
        },
        {
          "include": "#semicolon"
        }
      ]
    },
    "enum-type-only": {
      "match": "\\b(enum)\\s+([_a-zA-Z]\\w*)(?=\\s*(?:\\/\\/.*|\\/\\*.*)?$)",
      "captures": {
        "1": {
          "name": "storage.type.enum.qml"
        },
        "2": {
          "name": "entity.name.type.enum.qml"
        }
      }
    },
    "semicolon": {
      "name": "punctuation.terminator.statement.qml",
      "match": ";"
    },
    "enum": {
      "name": "meta.enum.qml",
      "begin": "\\b(enum)\\s+([_a-zA-Z]\\w*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.enum.qml"
        },
        "2": {
          "name": "entity.name.type.enum.qml"
        },
        "3": {
          "name": "punctuation.definition.block.qml"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.qml"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "\\b([_a-zA-Z]\\w*)\\b(?:\\s*(=)\\s*(-?(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?)))?",
          "captures": {
            "1": {
              "name": "variable.other.enummember.qml"
            },
            "2": {
              "name": "keyword.operator.assignment.qml"
            },
            "3": {
              "name": "constant.numeric.qml"
            }
          }
        },
        {
          "name": "punctuation.separator.comma.qml",
          "match": ","
        }
      ]
    },
    "signal": {
      "patterns": [
        {
          "name": "meta.signal.qml",
          "begin": "\\b(signal)\\s*([_a-zA-Z]\\w*)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "storage.type.signal.qml"
            },
            "2": {
              "name": "entity.name.function.signal.qml"
            },
            "3": {
              "name": "punctuation.definition.parameters.begin.qml"
            }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.end.qml"
            }
          },
          "patterns": [
            {
              "match": "(\\w+)\\s*:\\s*([\\w\\.]+(?:<[\\w\\.]+>)?)\\s*,?",
              "captures": {
                "1": {
                  "name": "variable.parameter.qml"
                },
                "2": {
                  "patterns": [
                    {
                      "include": "#type"
                    }
                  ]
                }
              }
            },
            {
              "match": "([\\w\\.]+(?:<[\\w\\.]+>)?)\\s+(\\w+)\\s*,?",
              "captures": {
                "1": {
                  "patterns": [
                    {
                      "include": "#type"
                    }
                  ]
                },
                "2": {
                  "name": "variable.parameter.qml"
                }
              }
            }
          ]
        },
        {
          "name": "meta.signal.qml",
          "match": "\\b(signal)\\s*([_a-zA-Z]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.signal.qml"
            },
            "2": {
              "name": "entity.name.function.signal.qml"
            }
          }
        }
      ]
    },
    "property-declaration": {
      "name": "meta.property.qml",
      "begin": "(?=\\b(?:(?:default|readonly|required|final|virtual|override)\\s+)*property\\s+[\\w\\.])",
      "end": "(?<=[;}\\]])|$|(?=\\})|(?=\\s*(?:\\/\\/|\\/\\*))",
      "patterns": [
        {
          "include": "#prop-custom"
        },
        {
          "include": "#attr-general"
        },
        {
          "include": "#semicolon"
        }
      ]
    },
    "prop-custom": {
      "patterns": [
        {
          "name": "storage.modifier.qml",
          "match": "\\b(?:default|readonly|required|final|virtual|override)\\b(?=(?:\\s+(?:default|readonly|required|final|virtual|override))*\\s+property\\b)"
        },
        {
          "match": "\\b(property)\\s+([\\w\\.]+(?:<[\\w\\.]+>)?)\\s+(\\w+)(?=\\s*:)",
          "captures": {
            "1": {
              "name": "storage.type.property.qml"
            },
            "2": {
              "patterns": [
                {
                  "include": "#type"
                }
              ]
            },
            "3": {
              "name": "entity.other.attribute-name.qml"
            }
          }
        },
        {
          "match": "\\b(property)\\s+([\\w\\.]+(?:<[\\w\\.]+>)?)\\s+(\\w+)(?=\\s*(?:;|//|/\\*|$))",
          "captures": {
            "1": {
              "name": "storage.type.property.qml"
            },
            "2": {
              "patterns": [
                {
                  "include": "#type"
                }
              ]
            },
            "3": {
              "name": "entity.other.attribute-name.qml"
            }
          }
        }
      ]
    },
    "prop-force-required": {
      "match": "\\b(required)\\s+(\\w+)(?=\\s*(?:;|//|/\\*|$))",
      "captures": {
        "1": {
          "name": "storage.modifier.qml"
        },
        "2": {
          "name": "entity.other.attribute-name.qml"
        }
      }
    },
    "type": {
      "patterns": [
        {
          "name": "keyword.other.alias.qml",
          "match": "\\balias\\b"
        },
        {
          "name": "storage.type.primitive.qml",
          "match": "\\b(?:bool|double|enumeration|int|list|real|string|url|var|variant|date|color|font|matrix4x4|point|quaternion|rect|size|vector2d|vector3d|vector4d)\\b(?!\\.)"
        },
        {
          "name": "punctuation.definition.typeparameters.begin.qml",
          "match": "<"
        },
        {
          "name": "punctuation.definition.typeparameters.end.qml",
          "match": ">"
        },
        {
          "name": "entity.name.type.qml",
          "match": "[\\w\\.]+"
        }
      ]
    },
    "method": {
      "begin": "\\b(?=function\\b)",
      "end": "(?<=\\})",
      "contentName": "meta.embedded.function.qml",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "on-prop": {
      "name": "meta.object.qml",
      "begin": "\\b([A-Z][\\w\\.]*)\\s+(on)\\s+([\\w\\.]+)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.object.qml"
        },
        "2": {
          "name": "keyword.other.on.qml"
        },
        "3": {
          "name": "entity.other.attribute-name.qml"
        },
        "4": {
          "name": "punctuation.definition.block.qml"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.qml"
        }
      },
      "patterns": [
        {
          "include": "#object-contents"
        }
      ]
    },
    "on-prop-type-only": {
      "match": "\\b([A-Z][\\w\\.]*)\\s+(on)\\s+([\\w\\.]+)(?=\\s*(?:\\/\\/.*|\\/\\*.*)?$)",
      "captures": {
        "1": {
          "name": "entity.name.type.object.qml"
        },
        "2": {
          "name": "keyword.other.on.qml"
        },
        "3": {
          "name": "entity.other.attribute-name.qml"
        }
      }
    },
    "comp-inline": {
      "name": "meta.component.qml",
      "begin": "\\b(component)\\s+([A-Z]\\w*)\\s*:",
      "beginCaptures": {
        "1": {
          "name": "storage.type.component.qml"
        },
        "2": {
          "name": "entity.name.type.component.qml"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "include": "#object"
        }
      ]
    },
    "attr-group-notation": {
      "begin": "\\b(\\w*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.qml"
        },
        "2": {
          "name": "punctuation.definition.block.qml"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.qml"
        }
      },
      "patterns": [
        {
          "include": "#attr-general"
        },
        {
          "include": "#comment"
        }
      ]
    },
    "id-assignment": {
      "match": "\\b(id)\\s*:\\s*([_a-zA-Z]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.other.id.qml"
        },
        "2": {
          "name": "entity.name.variable.id.qml"
        }
      }
    },
    "attr-general": {
      "patterns": [
        {
          "include": "#attr-object"
        },
        {
          "include": "#attr-list"
        },
        {
          "include": "#attr-block"
        },
        {
          "include": "#attr-expr"
        }
      ],
      "repository": {
        "attr-object": {
          "begin": "\\b([\\w\\.]*)\\s*:\\s*(?=[A-Z][\\w\\.]*\\s*\\{)",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.qml"
            }
          },
          "end": "(?<=\\})",
          "patterns": [
            {
              "include": "#object"
            }
          ]
        },
        "attr-list": {
          "begin": "\\b([\\w\\.]*)\\s*:\\s*\\[\\s*",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.qml"
            }
          },
          "end": "\\]",
          "contentName": "meta.embedded.list.qml",
          "patterns": [
            {
              "include": "#object-declaration"
            },
            {
              "include": "source.js"
            }
          ]
        },
        "attr-block": {
          "begin": "\\b([\\w\\.]*)\\s*:\\s*\\{\\s*",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.qml",
              "patterns": [
                {
                  "include": "#handler-name"
                }
              ]
            }
          },
          "end": "\\}",
          "contentName": "meta.embedded.block.qml",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        "attr-expr": {
          "begin": "\\b([\\w\\.]*)\\s*:\\s*(?=[^\\s]|$)",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.qml",
              "patterns": [
                {
                  "include": "#handler-name"
                }
              ]
            }
          },
          "end": "(;)|(?<=[^|&+\\-*%^=<>!?:,.~(\\[{\\s])(?=\\s*(?:$|\\/\\/))|(?=\\})",
          "endCaptures": {
            "1": {
              "name": "punctuation.terminator.statement.qml"
            }
          },
          "contentName": "meta.embedded.expression.qml",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        }
      }
    },
    "handler-name": {
      "name": "entity.name.function.handler.qml",
      "match": "\\bon[A-Z]\\w*"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.single.qml",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "name": "string.quoted.double.qml",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        }
      ]
    },
    "string-escape": {
      "patterns": [
        {
          "name": "constant.character.escape.qml",
          "match": "\\\\."
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.qml",
          "begin": "(\\/\\/)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment.qml"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#comment-contents"
            }
          ]
        },
        {
          "name": "comment.block.qml",
          "begin": "(\\/\\*)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment.qml"
            }
          },
          "end": "(\\*\\/)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.comment.qml"
            }
          },
          "patterns": [
            {
              "include": "#comment-contents"
            }
          ]
        }
      ],
      "repository": {
        "comment-contents": {
          "patterns": [
            {
              "name": "keyword.other.todo.qml",
              "match": "\\b(NOTE|TODO|DEBUG|XXX)\\b"
            },
            {
              "name": "invalid.illegal.todo.qml",
              "match": "\\b(BUG|FIXME|WARNING)\\b"
            }
          ]
        }
      }
    }
  }
}
