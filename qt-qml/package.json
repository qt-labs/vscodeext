{
  "name": "qt-qml",
  "displayName": "Qt Qml",
  "description": "Qt Qml Support",
  "version": "1.15.0",
  "homepage": "https://www.qt.io/",
  "icon": "res/icons/qt.png",
  "publisher": "theqtcompany",
  "repository": {
    "type": "git",
    "url": "https://github.com/qt-labs/vscodeext"
  },
  "bugs": {
    "url": "https://qt-project.atlassian.net/jira/software/c/projects/VSCODEEXT/issues"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets",
    "Debuggers"
  ],
  "keywords": [
    "Qt",
    "Qml"
  ],
  "qna": "marketplace",
  "pricing": "Free",
  "activationEvents": [],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "qt-qml.restartQmlls",
        "title": "%qt-qml.command.restartQmlls.title%",
        "category": "Qt"
      },
      {
        "command": "qt-qml.checkQmllsUpdate",
        "title": "%qt-qml.command.checkQmllsUpdate.title%",
        "category": "Qt"
      },
      {
        "command": "qt-qml.downloadQmlls",
        "title": "%qt-qml.command.downloadQmlls.title%",
        "category": "Qt"
      },
      {
        "command": "qt-qml.startQmlPreview",
        "title": "%qt-qml.command.startQmlPreview.title%",
        "category": "Qt",
        "icon": "$(run-all)"
      },
      {
        "command": "qt-qml.startQmlPreviewForCurrentFile",
        "title": "%qt-qml.command.startQmlPreviewForCurrentFile.title%",
        "category": "Qt",
        "icon": "$(play)"
      },
      {
        "command": "qt-qml.attachQmlPreview",
        "title": "%qt-qml.command.attachQmlPreview.title%",
        "category": "Qt"
      },
      {
        "command": "qt-qml.stopQmlPreview",
        "title": "%qt-qml.command.stopQmlPreview.title%",
        "category": "Qt",
        "icon": "$(stop-circle)"
      },
      {
        "command": "qt-qml.reloadQmlPreview",
        "title": "%qt-qml.command.reloadQmlPreview.title%",
        "category": "Qt"
      },
      {
        "command": "qt-qml.clearQmlPreviewCache",
        "title": "%qt-qml.command.clearQmlPreviewCache.title%",
        "category": "Qt"
      },
      {
        "command": "qt-qml.startQmlProfiler",
        "title": "%qt-qml.command.startQmlProfiler.title%",
        "category": "Qt",
        "icon": "$(record)"
      },
      {
        "command": "qt-qml.attachQmlProfiler",
        "title": "%qt-qml.command.attachQmlProfiler.title%",
        "category": "Qt"
      },
      {
        "command": "qt-qml.stopQmlProfiler",
        "title": "%qt-qml.command.stopQmlProfiler.title%",
        "category": "Qt",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "qt-qml.stopQmlPreview",
          "when": "qt-qml.qmlPreviewRunning"
        },
        {
          "command": "qt-qml.reloadQmlPreview",
          "when": "qt-qml.qmlPreviewRunning"
        },
        {
          "command": "qt-qml.clearQmlPreviewCache",
          "when": "qt-qml.qmlPreviewRunning"
        },
        {
          "command": "qt-qml.startQmlPreview",
          "when": "!qt-qml.qmlPreviewRunning && qt-qml.qmlPreviewLaunchEnabled"
        },
        {
          "command": "qt-qml.startQmlPreviewForCurrentFile",
          "when": "resourceLangId == qml && !qt-qml.qmlPreviewRunning && qt-qml.qmlPreviewLaunchEnabled"
        },
        {
          "command": "qt-qml.attachQmlPreview",
          "when": "!qt-qml.qmlPreviewRunning"
        },
        {
          "command": "qt-qml.startQmlProfiler",
          "when": "!qt-qml.qmlProfilerRunning && qt-qml.qmlPreviewLaunchEnabled"
        },
        {
          "command": "qt-qml.attachQmlProfiler",
          "when": "!qt-qml.qmlProfilerRunning"
        },
        {
          "command": "qt-qml.stopQmlProfiler",
          "when": "qt-qml.qmlProfilerRunning"
        }
      ],
      "editor/title": [
        {
          "command": "qt-qml.startQmlPreview",
          "when": "resourceLangId == qml && !qt-qml.qmlPreviewRunning && qt-qml.qmlPreviewLaunchEnabled",
          "group": "navigation@1"
        },
        {
          "command": "qt-qml.startQmlPreviewForCurrentFile",
          "when": "resourceLangId == qml && !qt-qml.qmlPreviewRunning && qt-qml.qmlPreviewLaunchEnabled",
          "group": "navigation@2"
        },
        {
          "command": "qt-qml.stopQmlPreview",
          "when": "resourceLangId == qml && qt-qml.qmlPreviewRunning",
          "group": "navigation@1"
        },
        {
          "command": "qt-qml.startQmlProfiler",
          "when": "resourceLangId == qml && !qt-qml.qmlProfilerRunning && qt-qml.qmlPreviewLaunchEnabled",
          "group": "navigation@3"
        },
        {
          "command": "qt-qml.stopQmlProfiler",
          "when": "resourceLangId == qml && qt-qml.qmlProfilerRunning",
          "group": "navigation@3"
        }
      ]
    },
    "languages": [
      {
        "id": "qml",
        "configuration": "./res/lang/qml/language-configuration.json",
        "extensions": [
          ".qml",
          ".qmlproject"
        ],
        "aliases": [
          "QML",
          "Qml",
          "qml"
        ],
        "icon": {
          "light": "res/icons/qml-light.svg",
          "dark": "res/icons/qml-dark.svg"
        }
      },
      {
        "id": "qmldir",
        "configuration": "./res/lang/qmldir/language-configuration.json",
        "filenames": [
          "qmldir"
        ],
        "aliases": [
          "QMLDir",
          "qmldir"
        ],
        "icon": {
          "light": "res/icons/qmldir-light.svg",
          "dark": "res/icons/qmldir-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "qml",
        "scopeName": "source.qml",
        "path": "./res/lang/qml/qml.qmlproject.tmLanguage.json"
      },
      {
        "language": "qmldir",
        "scopeName": "source.qmldir",
        "path": "./res/lang/qmldir/qmldir.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Qt Qml Configuration",
      "properties": {
        "qt-qml.qmlls.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run QML Language Server when activating an extension",
          "scope": "machine-overridable"
        },
        "qt-qml.qmlls.verboseOutput": {
          "type": "boolean",
          "default": false,
          "description": "Run QML Language Server with --verbose option",
          "scope": "machine-overridable"
        },
        "qt-qml.qmlls.traceLsp": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "messages",
            "compact",
            "verbose"
          ],
          "enumDescriptions": [
            "Off",
            "Show messages only",
            "Show messages with parameters as compact JSON",
            "Show messages with parameters as multiline JSON"
          ],
          "description": "Handle LSP trace",
          "scope": "machine-overridable"
        },
        "qt-qml.qmlls.customExePath": {
          "type": "string",
          "default": "",
          "description": "Specify the custom QML Language Server executable path",
          "scope": "machine-overridable"
        },
        "qt-qml.qmlls.customArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Use custom QML Language Server arguments instead of the default ones",
          "scope": "machine-overridable"
        },
        "qt-qml.qmlls.customDocsPath": {
          "type": "string",
          "default": "",
          "description": "Specify the documentation path for QML Language Server",
          "scope": "machine-overridable"
        },
        "qt-qml.qmlls.additionalImportPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Look for QML modules in the specified directories. Each entry will be added via the \"-I\" command argument when starting QML Language Server",
          "scope": "machine-overridable"
        },
        "qt-qml.qmlls.useQmlImportPathEnvVar": {
          "type": "boolean",
          "default": false,
          "description": "Use the QML_IMPORT_PATH environment variable to look for QML Modules. When set to true, the \"-E\" command argument will be added when starting QML Language Server",
          "scope": "machine-overridable"
        },
        "qt-qml.qmlls.useNoCMakeCalls": {
          "type": "boolean",
          "default": false,
          "description": "Use --no-cmake-calls option when starting QML Language Server",
          "scope": "machine-overridable"
        },
        "qt-qml.doNotAskForQmllsDownload": {
          "type": "boolean",
          "default": false,
          "description": "Do not ask for downloading QML Language Server",
          "scope": "machine"
        },
        "qt-qml.preview.additionalBuildDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional build directories to search for QRC files during QML preview. Useful when the build directory is outside the workspace.",
          "scope": "machine-overridable"
        },
        "qt-qml.preview.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Default command line arguments to pass to the QML Preview application when started from commands (not used for tasks).",
          "scope": "machine-overridable"
        },
        "qt-qml.profiler.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra command line arguments to pass to the application when starting QML Profiler.",
          "scope": "machine-overridable"
        }
      }
    },
    "breakpoints": [
      {
        "language": "qml"
      }
    ],
    "debuggers": [
      {
        "type": "qml",
        "label": "QML debugger",
        "runtime": "node",
        "configurationAttributes": {
          "attach": {
            "required": [
              "host",
              "port"
            ],
            "properties": {
              "host": {
                "type": "string",
                "description": "Hostname (or IP address) of the target program's debug service",
                "default": "localhost"
              },
              "port": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "Port of the target program's debug service"
              },
              "buildDirs": {
                "type": "array",
                "description": "List of build directories to include in the debugger. This variable is useful when the build directory is not in the workspace.",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the program to be debugged"
              },
              "debuggerArgs": {
                "type": "string",
                "description": "Command line arguments passed to the program"
              },
              "args": {
                "type": "array",
                "description": "Additional command line arguments passed to the program",
                "items": {
                  "type": "string"
                }
              },
              "buildDirs": {
                "type": "array",
                "description": "List of build directories to include in the debugger. This variable is useful when the build directory is not in the workspace.",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "qml",
            "request": "attach",
            "name": "Attach to QML debugger",
            "host": "localhost",
            "port": "^\"Custom port or \\${command:qt-qml.debugPort} for compound usage\""
          }
        ],
        "configurationSnippets": [
          {
            "label": "%qt-qml.debug.qmlDebuggingLaunch.label%",
            "description": "%qt-qml.debug.qmlDebuggingLaunch.description%",
            "body": {
              "name": "%qt-qml.debug.qmlDebuggingLaunch.label%",
              "type": "qml",
              "request": "launch",
              "program": "^\"\\${command:cmake.launchTargetPath}\""
            }
          },
          {
            "label": "%qt-qml.debug.qmlDebuggingAttach.label%",
            "description": "%qt-qml.debug.qmlDebuggingAttach.description%",
            "body": {
              "name": "%qt-qml.debug.qmlDebuggingAttach.label%",
              "type": "qml",
              "request": "attach",
              "host": "localhost",
              "port": "^\"Custom port or \\${command:qt-qml.debugPort} for compound usage\""
            }
          },
          {
            "label": "%qt-qml.debug.cppdbg.label%",
            "description": "%qt-qml.debug.cppdbg.description%",
            "body": {
              "name": "%qt-qml.debug.cppdbg.label%",
              "type": "cppdbg",
              "request": "launch",
              "program": "^\"\\${command:cmake.launchTargetPath}\"",
              "stopAtEntry": false,
              "cwd": "^\"\\${workspaceFolder}\"",
              "visualizerFile": "^\"\\${command:qt-cpp.natvis}\"",
              "showDisplayString": true,
              "args": [
                "^\"-qmljsdebugger=host:localhost,port:\\${command:qt-qml.debugPort},block,services:DebugMessages,QmlDebugger,V8Debugger\""
              ],
              "linux": {
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb",
                "sourceFileMap": {
                  "/home/qt/work/qt": "^\"\\${command:qt-cpp.sourceDirectory}\""
                }
              },
              "osx": {
                "MIMode": "lldb",
                "sourceFileMap": {
                  "/Users/qt/work/qt": "^\"\\${command:qt-cpp.sourceDirectory}\""
                }
              },
              "windows": {
                "sourceFileMap": {
                  "Q:/qt5_workdir/w/s": "^\"\\${command:qt-cpp.sourceDirectory}\"",
                  "C:/work/build/qt5_workdir/w/s": "^\"\\${command:qt-cpp.sourceDirectory}\"",
                  "c:/users/qt/work/qt": "^\"\\${command:qt-cpp.sourceDirectory}\"",
                  "c:/Users/qt/work/install": "^\"\\${command:qt-cpp.sourceDirectory}\"",
                  "/Users/qt/work/qt": "^\"\\${command:qt-cpp.sourceDirectory}\""
                },
                "environment": [
                  {
                    "name": "PATH",
                    "value": "^\"\\${env:PATH};\\${command:qt-cpp.qtDir}\""
                  },
                  {
                    "name": "QT_QPA_PLATFORM_PLUGIN_PATH",
                    "value": "^\"\\${command:qt-cpp.QT_QPA_PLATFORM_PLUGIN_PATH}\""
                  },
                  {
                    "name": "QML_IMPORT_PATH",
                    "value": "^\"\\${command:qt-cpp.QML_IMPORT_PATH}\""
                  }
                ],
                "MIMode": "gdb",
                "miDebuggerPath": "^\"\\${command:qt-cpp.minGWgdb}\""
              }
            }
          },
          {
            "label": "%qt-qml.debug.cppvsdbg.label%",
            "description": "%qt-qml.debug.cppvsdbg.description%",
            "body": {
              "name": "%qt-qml.debug.cppvsdbg.label%",
              "type": "cppvsdbg",
              "request": "launch",
              "program": "^\"\\${command:cmake.launchTargetPath}\"",
              "stopAtEntry": false,
              "cwd": "^\"\\${workspaceFolder}\"",
              "visualizerFile": "^\"\\${command:qt-cpp.natvis}\"",
              "args": [
                "^\"-qmljsdebugger=host:localhost,port:\\${command:qt-qml.debugPort},block,services:DebugMessages,QmlDebugger,V8Debugger\""
              ],
              "windows": {
                "sourceFileMap": {
                  "Q:/qt5_workdir/w/s": "^\"\\${command:qt-cpp.sourceDirectory}\"",
                  "C:/work/build/qt5_workdir/w/s": "^\"\\${command:qt-cpp.sourceDirectory}\"",
                  "c:/users/qt/work/qt": "^\"\\${command:qt-cpp.sourceDirectory}\"",
                  "c:/Users/qt/work/install": "^\"\\${command:qt-cpp.sourceDirectory}\"",
                  "/Users/qt/work/qt": "^\"\\${command:qt-cpp.sourceDirectory}\""
                },
                "environment": [
                  {
                    "name": "PATH",
                    "value": "^\"\\${env:PATH};\\${command:qt-cpp.qtDir}\""
                  },
                  {
                    "name": "QT_QPA_PLATFORM_PLUGIN_PATH",
                    "value": "^\"\\${command:qt-cpp.QT_QPA_PLATFORM_PLUGIN_PATH}\""
                  },
                  {
                    "name": "QML_IMPORT_PATH",
                    "value": "^\"\\${command:qt-cpp.QML_IMPORT_PATH}\""
                  }
                ]
              }
            }
          },
          {
            "label": "%qt-qml.debug.pyside.label%",
            "description": "%qt-qml.debug.pyside.description%",
            "body": {
              "name": "%qt-qml.debug.pyside.label%",
              "type": "debugpy",
              "request": "launch",
              "program": "^\"\\${workspaceFolder}/main.py\"",
              "preLaunchTask": "PySide: build",
              "args": [
                "^\"-qmljsdebugger=port:\\${command:qt-qml.debugPort},block,services:DebugMessages,QmlDebugger,V8Debugger\""
              ]
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "Qt"
      }
    ]
  },
  "extensionDependencies": [
    "theqtcompany.qt-core"
  ],
  "scripts": {
    "vscode:prepublish": "cross-env NODE_ENV=production node ./esbuild.mjs && git rev-parse HEAD > commit",
    "compile": "node ./esbuild.mjs",
    "compile-test": "node ./esbuild.mjs --test",
    "watch": "node ./esbuild.mjs --watch",
    "pretest": "npm run compile && npm run lint",
    "prepare-vsix": "npm --prefix ../qt-core run package",
    "run-test": "cd ./out/test/ && node runTest.js",
    "run-test-qml-debug": "cd ./out/test/ && node runTest.qml-debug.js",
    "test:only:qml-debug": "npm run compile-test && npm run run-test-qml-debug --",
    "test:only": "npm run compile-test && npm run run-test && npm run run-test-qml-debug",
    "run-tests": "cd ./out/test/ && cross-env QT_TEST_QT_ROOT=${npm_config_qt_root:-$QT_TEST_QT_ROOT} node runTest.js && cross-env QT_TEST_QT_ROOT=${npm_config_qt_root:-$QT_TEST_QT_ROOT} node runTest.qml-debug.js",
    "test:qml-debug": "npm run prepare-vsix && npm run test:only:qml-debug --",
    "test": "npm run prepare-vsix && npm run test:only --",
    "lint": "npm run prettierWrite && eslint . --fix --cache",
    "prettierWrite": "npm run prettierBase -- --write \"**/*.{js,ts,mts,json,mjs,cjs}\" --log-level silent",
    "prettierCheck": "npm run prettierBase -- --check \"**/*.{js,ts,mts,json,mjs,cjs}\"",
    "prettierBase": "prettier --config \"../common/.prettierrc\" --ignore-path \"../common/.prettierignore\" --cache --cache-strategy metadata",
    "package": "vsce package --out out && rm commit"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.21.0",
    "@types/chai": "^5.2.2",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.94.0",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "glob": "^11.0.2",
    "mocha": "^11.3.0",
    "prettier": "^3.3.3",
    "sinon": "^21.0.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "async-mutex": "^0.5.0",
    "get-port": "^7.1.0",
    "module-alias": "^2.2.3",
    "promise-socket": "^8.0.0",
    "qt-lib": "file:../qt-lib",
    "typescript": "^5.6.3",
    "vscode-languageclient": "^9.0.1",
    "yauzl": "^3.1.3"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.3"
  }
}
