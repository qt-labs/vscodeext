        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}/qt-python"
      }
    },
    {
      "label": "qt-cpp: prepare test build",
      "type": "shell",
      "command": "npx ts-node ./qt-cpp/test/scripts/prepare_test_build.ts",
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "qt-cpp: build test clean",
      "type": "shell",
      "command": "npx ts-node ./qt-cpp/test/scripts/clean_test_build.ts",
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "qt-cpp: build test prelaunch chain",
      "dependsOn": [
        "qt-cpp: prepare test build",
        "npm qt-cpp watch and test"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "qt-cpp: prepare test natvis",
      "type": "shell",
      "command": "npx ts-node ./qt-cpp/test/scripts/prepare_test_natvis.ts",
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "qt-cpp: natvis test clean",
      "type": "shell",
      "command": "npx ts-node ./qt-cpp/test/scripts/clean_test_natvis.ts",
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "qt-cpp: natvis test prelaunch chain",
      "dependsOn": [
        "qt-cpp: prepare test natvis",
        "npm qt-cpp watch and test"
      ],
      "dependsOrder": "sequence"
    },
  ]
