{
  "name": "qt-core",
  "displayName": "Qt Core",
  "description": "Qt Core",
  "version": "1.15.0",
  "homepage": "https://www.qt.io/",
  "icon": "res/icons/qt.png",
  "publisher": "theqtcompany",
  "repository": {
    "type": "git",
    "url": "https://github.com/qt-labs/vscodeext"
  },
  "bugs": {
    "url": "https://qt-project.atlassian.net/jira/software/c/projects/VSCODEEXT/issues"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "Qt",
    "C++",
    "CMake",
    "Qml",
    "Qrc",
    "Qss",
    "Qdoc"
  ],
  "qna": "marketplace",
  "pricing": "Free",
  "activationEvents": [
    "workspaceContains:**/*.qrc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default"
      }
    },
    "commands": [
      {
        "command": "qt-core.documentationHomepage",
        "title": "%qt-core.command.documentationHomepage.title%",
        "category": "Qt"
      },
      {
        "command": "qt-core.documentationSearchManually",
        "title": "%qt-core.command.documentationSearchManually.title%",
        "category": "Qt"
      },
      {
        "command": "qt-core.documentationSearchForCurrentWord",
        "title": "%qt-core.command.documentationSearchForCurrentWord.title%",
        "category": "Qt"
      },
      {
        "command": "qt-core.openSettings",
        "title": "%qt-core.command.openSettings.title%",
        "category": "Qt"
      },
      {
        "command": "qt-core.reportIssue",
        "title": "%qt-core.command.reportIssue.title%",
        "category": "Qt"
      },
      {
        "command": "qt-core.setRecommendedSettings",
        "title": "%qt-core.command.setRecommendedSettings.title%",
        "category": "Qt"
      },
      {
        "command": "qt-core.registerQt",
        "title": "%qt-core.command.registerQt.title%",
        "category": "Qt"
      },
      {
        "command": "qt-core.reset",
        "title": "%qt-core.command.reset.title%",
        "category": "Qt"
      },
      {
        "command": "qt-core.registerQtByQtpaths",
        "title": "%qt-core.command.registerQtByQtpaths.title%",
        "category": "Qt"
      },
      {
        "command": "qt-core.createNewItem",
        "title": "%qt-core.command.createNewItem.title%",
        "category": "Qt"
      },
      {
        "command": "qt-core.openInLinguist",
        "title": "%qt-core.command.openInLinguist.title%",
        "category": "Qt"
      },
      {
        "command": "qt-core.openExamplesBrowser",
        "title": "%qt-core.command.openExamplesBrowser.title%",
        "category": "Qt"
      },
      {
        "command": "qt-core.openCoursesBrowser",
        "title": "%qt-core.command.openCoursesBrowser.title%",
        "category": "Qt"
      },
      {
        "command": "qt-core.openWelcomePage",
        "title": "%qt-core.command.openWelcomePage.title%",
        "category": "Qt"
      }
    ],
    "customEditors": [
      {
        "viewType": "qt-core.qrcEditor",
        "displayName": "QRC editor",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.qrc"
          }
        ]
      },
      {
        "viewType": "qt-core.qmlTrace",
        "displayName": "QML trace",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.{qtd,qzt}"
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "qrc",
        "configuration": "./res/lang/qrc/language-configuration.json",
        "extensions": [
          ".qrc",
          ".qrc.cmakein"
        ],
        "aliases": [
          "QRC",
          "Qrc"
        ],
        "icon": {
          "light": "res/icons/qrc-light.svg",
          "dark": "res/icons/qrc-dark.svg"
        }
      },
      {
        "id": "qss",
        "configuration": "./res/lang/qss/language-configuration.json",
        "extensions": [
          ".qss"
        ],
        "aliases": [
          "QSS",
          "Qss"
        ],
        "icon": {
          "light": "res/icons/qss-light.svg",
          "dark": "res/icons/qss-dark.svg"
        }
      },
      {
        "id": "qdoc",
        "configuration": "./res/lang/qdoc/language-configuration.json",
        "extensions": [
          ".qdoc",
          ".qdocconf",
          ".qdocinc"
        ],
        "aliases": [
          "QDoc",
          "Qdoc",
          "qdoc"
        ],
        "icon": {
          "light": "res/icons/qdoc-light.svg",
          "dark": "res/icons/qdoc-dark.svg"
        }
      },
      {
        "id": "qt-ts",
        "configuration": "./res/lang/qt-ts/language-configuration.json",
        "aliases": [
          "Qt TS",
          "Qt Translation Script"
        ],
        "icon": {
          "light": "res/icons/qt-ts-light.svg",
          "dark": "res/icons/qt-ts-dark.svg"
        }
      },
      {
        "id": "qtd",
        "configuration": "./res/lang/qtd/language-configuration.json",
        "extensions": [
          ".qtd"
        ],
        "aliases": [
          "QTD",
          "Qt QML Profiler Trace (text)"
        ],
        "icon": {
          "light": "res/icons/qtd-light.svg",
          "dark": "res/icons/qtd-dark.svg"
        }
      },
      {
        "id": "qzt",
        "extensions": [
          ".qzt"
        ],
        "aliases": [
          "QZT",
          "Qt QML Profiler Trace (compressed)"
        ],
        "icon": {
          "light": "res/icons/qzt-light.svg",
          "dark": "res/icons/qzt-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "qdoc",
        "scopeName": "source.qdoc",
        "path": "./res/lang/qdoc/qdoc.tmLanguage.json"
      },
      {
        "language": "qrc",
        "scopeName": "source.qrc",
        "path": "./res/lang/qrc/qrc.tmLanguage.json"
      },
      {
        "language": "qss",
        "scopeName": "source.qss",
        "path": "./res/lang/qss/qss.tmLanguage.json"
      },
      {
        "language": "qt-ts",
        "scopeName": "source.qt-ts",
        "path": "./res/lang/qt-ts/qt-ts.tmLanguage.json"
      },
      {
        "language": "qtd",
        "scopeName": "source.qtd",
        "path": "./res/lang/qtd/qtd.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Qt Core Configuration",
      "properties": {
        "qt-core.qtInstallationRoot": {
          "type": "string",
          "default": "",
          "description": "Specify the Qt Installation Root",
          "scope": "machine-overridable"
        },
        "qt-core.doNotAskForDefaultQtInstallationRoot": {
          "type": "boolean",
          "default": false,
          "description": "Do not ask for default Qt Installation Root",
          "scope": "machine"
        },
        "qt-core.doNotAskForVCPKG": {
          "type": "boolean",
          "default": false,
          "description": "Do not ask for vcpkg",
          "scope": "machine"
        },
        "qt-core.additionalQtPaths": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ]
          },
          "default": [],
          "description": "Specify additional Qt installations as paths to the qtpaths or qmake executable",
          "scope": "machine-overridable"
        },
        "qt-core.openOnlineDocumentationInExternalBrowser": {
          "type": "boolean",
          "default": false,
          "description": "Open online documentation in external browser",
          "scope": "machine-overridable"
        },
        "qt-core.defaultProjectDirectory": {
          "type": "string",
          "default": "",
          "description": "Specify the default project directory when creating new projects",
          "scope": "machine-overridable"
        },
        "qt-core.enableQrcEditor": {
          "type": "boolean",
          "default": true,
          "description": "Turn off the QRC editor to open .qrc files in the default text editor",
          "scope": "machine-overridable"
        },
        "qt-core.showWelcomePageOnActivation": {
          "type": "boolean",
          "default": true,
          "description": "Show welcome page when the extension gets activated",
          "scope": "machine-overridable"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "qt-core.openInLinguist",
          "when": "editorLangId == qt-ts",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "cross-env NODE_ENV=production npm run compile && git rev-parse HEAD > commit",
    "compile": "npm run build:webview && node ./esbuild.mjs",
    "compile-test": "node ./esbuild.mjs --test",
    "watch": "node ./esbuild.mjs --watch",
    "pretest": "npm run compile && npm run lint",
    "test:only": "npm run compile-test && cd ./out/test/ && node runTest.js",
    "test": "npm run test:only --",
    "lint": "npm run prettierWrite && eslint . --fix --cache",
    "prettierWrite": "npm run prettierBase -- --write \"**/*.{js,ts,mts,json,mjs,cjs,mts}\" --log-level silent",
    "prettierCheck": "npm run prettierBase -- --check \"**/*.{js,ts,mts,json,mjs,cjs,mts}\"",
    "prettierBase": "prettier --config \"../common/.prettierrc\" --ignore-path \"../common/.prettierignore\" --cache --cache-strategy metadata",
    "package": "vsce package --out out && rm commit",
    "ci:all": "npm run ci:webview && npm ci",
    "install:all": "npm run install:webview && npm install",
    "ci:webview": "cd webview-ui && npm ci",
    "build:webview": "cd webview-ui && npm run build",
    "install:webview": "cd webview-ui && npm install"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.21.0",
    "@types/chai": "^5.2.2",
    "@types/command-exists": "^1.2.3",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@types/jimp": "^0.2.1",
    "@types/lodash": "^4.17.12",
    "@types/lodash-es": "^4.17.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/pngjs": "^6.0.5",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.94.0",
    "@types/which": "^3.0.4",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "chai": "^5.2.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "glob": "^11.0.2",
    "mocha": "^11.3.0",
    "prettier": "^3.3.3",
    "sinon": "^21.0.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "command-exists": "^1.2.9",
    "dotenv": "^16.5.0",
    "fast-xml-parser": "^5.2.5",
    "jimp": "^1.6.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "module-alias": "^2.2.3",
    "qt-lib": "file:../qt-lib",
    "rss-parser": "^3.13.0",
    "typescript": "^5.6.3",
    "which": "^5.0.0"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.3"
  }
}
