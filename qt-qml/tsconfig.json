{
  "extends": "../common/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM"],
    "outDir": "out",
    "rootDirs": ["src", "test"],
    "paths": {
      "@/*": ["./src/*"],
      "@cmd/*": ["./src/commands/*"],
      "@task/*": ["./src/tasks/*"],
      "@util/*": ["./src/util/*"],
      "@debug/*": ["./src/debug/*"],
      "@preview/*": ["./src/preview/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
