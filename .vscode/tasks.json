        "vite:start"
      ],
      "dependsOrder": "parallel"
    },
    {
      "type": "shell",
      "label": "npm qt-core watch and test",
      "problemMatcher": "$tsc-watch",
      "command": "npm run watch && npm run compile-test",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}/qt-core"
      }
    },
    {
      "type": "shell",
      "label": "vite:start",
      "command": "npx ts-node ./scripts/run_vite.ts start --dir ../qt-core/webview-ui",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "type": "shell",
      "label": "vite:stop",
      "command": "npx ts-node ./scripts/run_vite.ts stop --dir ../qt-core/webview-ui",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "type": "shell",
      "label": "npm qt-python watch",
      "problemMatcher": "$tsc-watch",
      "command": "npm run watch",
      "isBackground": true,
