{
  "extends": "../common/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "outDir": "out",
    "rootDirs": ["src", "test"],
    "paths": {
      "@/*": ["./src/*"],
      "@cmd/*": ["./src/commands/*"],
      "@task/*": ["./src/tasks/*"],
      "@util/*": ["./src/util/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
