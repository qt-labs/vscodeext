{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "npm qt-cpp watch",
      "problemMatcher": "$tsc-watch",
      "command": "npm run watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}/qt-cpp"
      }
    },
    {
      "type": "shell",
      "label": "npm qt-cpp watch and test",
      "problemMatcher": "$tsc-watch",
      "command": "npm run watch && npm run compile-test",
