      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}/qt-cpp",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/c"]
        }
      }
    },
    {
      "type": "shell",
      "label": "npm qt-python watch and test",
      "problemMatcher": "$tsc-watch",
      "command": "npm run watch && npm run compile-test",
